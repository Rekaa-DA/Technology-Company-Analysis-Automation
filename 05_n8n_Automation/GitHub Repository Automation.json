    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst requiredColumns = [\n  \"company\",\n  \"repository_name\",\n  \"programming_language\",\n  \"stars\",\n  \"forks\",\n  \"watchers\",\n  \"open_issues\",\n  \"repository_size_kb\",\n  \"license\",\n  \"archived\",\n  \"created_date\",\n  \"updated_date\",\n  \"repository_url\"\n];\n\nconst seen = new Set();\nconst cleanedData = [];\n\nfor (const item of items) {\n\n  const row = item.json;\n\n  const cleanRow = {\n    company: row.company || \"\",\n    repository_name: row.repository_name || \"\",\n    programming_language: row.programming_language || \"Unknown\",\n    stars: Number(row.stars) || 0,\n    forks: Number(row.forks) || 0,\n    watchers: Number(row.watchers) || 0,\n    open_issues: Number(row.open_issues) || 0,\n    repository_size_kb: Number(row.repository_size_kb) || 0,\n    license: row.license || \"No License\",\n    archived: row.archived,\n    created_date: row.created_date || \"\",\n    updated_date: row.updated_date || \"\",\n    repository_url: row.repository_url || \"\"\n  };\n\n  // Convert archived status\n  if (\n    cleanRow.archived === true ||\n    String(cleanRow.archived).toLowerCase() === \"true\" ||\n    String(cleanRow.archived).toLowerCase() === \"archived\"\n  ) {\n    cleanRow.archived = 1;\n  } else {\n    cleanRow.archived = 0;\n  }\n\n  // Remove duplicate repositories\n  const duplicateKey =\n    `${cleanRow.company}_${cleanRow.repository_name}`;\n\n  if (!seen.has(duplicateKey)) {\n\n    seen.add(duplicateKey);\n\n    cleanedData.push({\n      json: cleanRow\n    });\n  }\n}\n\nreturn cleanedData;"
      },
